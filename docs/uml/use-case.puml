@startuml
left to right direction

actor "Жіберуші\n(Sender)" as Sender
actor "Алушы\n(Recipient)" as Recipient
actor "Пошта қызметкері\n(Post Office Employee)" as Employee
actor "Курьер\n(Courier)" as Courier

rectangle "Қазпошта — сәлемдеме жеткізу және трекинг жүйесі" {
    usecase "Сәлемдемені тіркеу" as UC1
    usecase "Трек-нөмір беру" as UC2
    usecase "Трек-нөмір арқылы іздеу" as UC3
    usecase "Ағымдағы статусты қарау" as UC4
    usecase "Статус тарихын қарау" as UC5
    usecase "Сәлемдеме статусын жаңарту" as UC6
    usecase "Барлық сәлемдемелерді көру" as UC7
    usecase "CSV есепті экспорттау" as UC8
}

Employee --> UC1
Employee --> UC6
Employee --> UC7
Employee --> UC8

Sender --> UC3
Sender --> UC4
Sender --> UC5

Recipient --> UC3
Recipient --> UC4
Recipient --> UC5

Courier --> UC6

UC1 ..> UC2 : <<include>>
UC3 ..> UC4 : <<include>>

@enduml
